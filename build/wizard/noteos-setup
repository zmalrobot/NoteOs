#!/usr/bin/env python3
"""
noteos-setup — Entry point CLI del Wizard Grafico Touch di Primo Avvio per NoteOS (GT-N8000)
Supporta:
  noteos-setup            (avvio standard al primo boot se /var/lib/noteos/setup.done non esiste)
  noteos-setup --rerun    (rilancia il wizard anche dopo il completamento)
  noteos-setup --dry-run  (simulazione sicura per test su PC / Xephyr)
"""

import os
import runpy
import sys


def main():
    here = os.path.dirname(os.path.abspath(__file__))
    candidates = [
        os.path.join(here, "wizard_app.py"),
        "/usr/share/noteos-setup/wizard_app.py",
    ]
    for path in candidates:
        if os.path.exists(path):
            wdir = os.path.dirname(path)
            if wdir not in sys.path:
                sys.path.insert(0, wdir)
            sys.argv[0] = path
            runpy.run_path(path, run_name="__main__")
            return 0
    sys.stderr.write("ERRORE: wizard_app.py non trovato!\n")
    return 1


if __name__ == "__main__":
    sys.exit(main())

