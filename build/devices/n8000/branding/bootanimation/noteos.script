# Plymouth Script per animazione NoteOS (Samsung GT-N8000 1280x800)
Window.GetMaxWidth = fun () { return Window.GetWidth(); };
Window.GetMaxHeight = fun () { return Window.GetHeight(); };

# Sfondo scuro coerente con NoteOS KDE Dark
Window.SetBackgroundTopColor(0.086, 0.106, 0.133);
Window.SetBackgroundBottomColor(0.086, 0.106, 0.133);

num_frames = 30;

# Inizializza subito il primo frame per visualizzazione immediata dello splash
anim_images[0] = Image("0000.png");
anim_sprite = Sprite(anim_images[0]);
anim_sprite.SetPosition(0, 0, 0);
anim_sprite.SetOpacity(1);

# Carica i frame successivi dell'animazione
for (i = 1; i < num_frames; i++) {
  if (i < 10)
    filename = "000" + i + ".png";
  else
    filename = "00" + i + ".png";
  anim_images[i] = Image(filename);
}

progress = 0;

fun refresh_callback () {
  progress = progress + 1;
  if (progress >= num_frames) {
    progress = 0;
  }
  anim_sprite.SetImage(anim_images[progress]);
}

Plymouth.SetRefreshFunction(refresh_callback);
