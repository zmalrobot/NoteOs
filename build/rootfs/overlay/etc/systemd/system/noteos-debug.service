[Unit]
Description=Diagnostica USB Ethernet (usb0) e SSH temporaneo (attivo solo con debug=1 in cmdline)
After=network-pre.target
Before=network.target NetworkManager.service
ConditionKernelCommandLine=debug=1

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=30
ExecStart=/bin/sh -c '\
    mkdir -p /etc/NetworkManager/conf.d; \
    printf "[keyfile]\nunmanaged-devices=interface-name:usb0\n" > /etc/NetworkManager/conf.d/99-unmanaged-usb0.conf; \
    ip link set usb0 up 2>/dev/null || true; \
    ip addr replace 192.168.3.2/24 dev usb0 2>/dev/null || true; \
    ip addr add 192.168.2.2/24 dev usb0 2>/dev/null || true; \
    ip route replace default via 192.168.3.100 dev usb0 2>/dev/null || true; \
    echo "nameserver 8.8.8.8" > /etc/resolv.conf; \
    echo "root:n8000debug" | chpasswd; \
    mkdir -p /etc/ssh/sshd_config.d /run/sshd; \
    chmod 0755 /run/sshd; \
    printf "PermitRootLogin yes\nPasswordAuthentication yes\n" > /etc/ssh/sshd_config.d/99-n8000-debug.conf; \
    ssh-keygen -A 2>/dev/null || true; \
    systemctl --no-block start ssh.service || true'

[Install]
WantedBy=multi-user.target
