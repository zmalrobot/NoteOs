# Frammento Kconfig per Samsung Galaxy Note 10.1 (GT-N8000 / p4note)
# Kernel Linux 6.6.158 LTS — eMMC ed ext4 built-in, driver periferiche modulari

# 1. Compatibilita Bootloader S-BOOT e ATAGS
CONFIG_ARM_APPENDED_DTB=y
CONFIG_ARM_ATAG_DTB_COMPAT=y
CONFIG_ARM_ATAG_DTB_COMPAT_CMDLINE_EXTEND=y
CONFIG_CMDLINE_FORCE=y
CONFIG_CMDLINE="console=tty0 root=LABEL=debian_root rootfstype=ext4 rw rootwait quiet splash loglevel=0 vt.global_cursor_default=0 systemd.show_status=false"

# 2. Compressione Kernel (XZ obbligatorio per rispettare il limite < 7,5 MiB su BOOT)
CONFIG_KERNEL_XZ=y

# 3. Initramfs integrato (indipendente da offset ramdisk S-BOOT)
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE="/work/out/n8000/initramfs.cpio"
CONFIG_INITRAMFS_FORCE=y

# 5. Storage eMMC/SD ed ext4 built-in (obbligatori per mount rootfs), ZRAM
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_EXYNOS=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_LOOP_MIN_COUNT=8
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_ZRAM=y
CONFIG_ZRAM_DEF_COMP_LZ4=y
CONFIG_CRYPTO_LZ4=y

# 6. Requisiti Systemd e Container/Sandbox Desktop
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_PAGE_COUNTER=y
CONFIG_MEMCG=y
CONFIG_CGROUP_SCHED=y
CONFIG_AUTOFS_FS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_SECCOMP=y
CONFIG_INOTIFY_USER=y
CONFIG_FANOTIFY=y

# 7. USB DWC2 Controller, PHY e Gadget Ethernet (RNDIS/CDC per debug=1)
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_DUAL_ROLE=y
CONFIG_PHY_SAMSUNG_USB2=y
CONFIG_USB_GADGET=y
CONFIG_USB_ETH=y
CONFIG_USB_ETH_RNDIS=y

# 8. Display FIMD, Backlight, Console Framebuffer (con Deferred Takeover) e GPU 3D Mali-400 Lima
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER=y
CONFIG_DRM=y
CONFIG_DRM_EXYNOS=y
CONFIG_DRM_EXYNOS_FIMD=y
CONFIG_DRM_PANEL_SIMPLE=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FB_SIMPLE=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_LIMA=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y

# 9. Touchscreen Atmel maXTouch e Tasti GPIO
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_ATMEL_MXT=y
CONFIG_KEYBOARD_GPIO=y

# 10. Alimentazione, Batteria MAX17042 e Charger SMB347
CONFIG_MFD_MAX77686=y
CONFIG_REGULATOR_MAX77686=y
CONFIG_RTC_DRV_MAX77686=y
CONFIG_BATTERY_MAX17042=y
CONFIG_CHARGER_SMB347=y

# 11. Moduli nel Rootfs: Wi-Fi Broadcom BCM4334, Bluetooth, Audio WM8994/I2S, Sensori IIO
CONFIG_CFG80211=m
CONFIG_BRCMUTIL=m
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_SDIO=y
CONFIG_BT=m
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_RFCOMM=m
CONFIG_BT_BNEP=m
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_H4=y
CONFIG_BT_HCIUART_BCM=y
CONFIG_BT_BCM=m
CONFIG_SOUND=m
CONFIG_SND=m
CONFIG_SND_SOC=m
CONFIG_SND_SOC_SAMSUNG=m
CONFIG_SND_SAMSUNG_I2S=m
CONFIG_SND_SOC_WM8994=m
CONFIG_IIO=m
CONFIG_IIO_ST_ACCEL_3AXIS=m
CONFIG_IIO_ST_GYRO_3AXIS=m
CONFIG_AK8975=m
CONFIG_CM36651=m

